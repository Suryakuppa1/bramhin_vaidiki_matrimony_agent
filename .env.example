# Generate using @BotFather; keep it secret.
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to search and download names.
# Send /myid to your bot first to learn your Telegram user ID.
AUTHORIZED_USER_IDS=
# Comma-separated numeric group chat IDs whose admins approved /submit.
# Leave empty to disable group submissions. /myid from the group shows chat ID.
ALLOWED_GROUP_IDS=
# Notify the authorized user in private when a new consented profile matches saved filters.
ENABLE_MATCH_ALERTS=true
